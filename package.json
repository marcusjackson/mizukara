{
  "name": "mizukara",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:vrt": "playwright test e2e/visual-regression.test.ts --project=visual",
    "test:all": "vitest run && playwright test --project=chromium",
    "type-check": "vue-tsc --noEmit",
    "lint": "prettier --check . && eslint . && stylelint \"src/**/*.{css,vue}\" && vue-tsc --noEmit",
    "lint-fix": "prettier --write --list-different . && eslint . --fix && stylelint \"src/**/*.{css,vue}\" --fix && vue-tsc --noEmit",
    "check": "pnpm lint",
    "check:fix": "pnpm lint-fix",
    "prettier-only": "prettier --check",
    "prettier-fix-only": "prettier --write --list-different",
    "eslint-only": "eslint",
    "eslint-fix-only": "eslint --fix",
    "stylelint-only": "stylelint \"src/**/*.{css,vue}\"",
    "stylelint-fix-only": "stylelint \"src/**/*.{css,vue}\" --fix",
    "check:unused": "python3 find-unused-files.py",
    "check:untested": "python3 find-untested-files.py",
    "ci": "pnpm lint && pnpm test",
    "ci:full": "pnpm lint && pnpm test:all"
  },
  "dependencies": {
    "@vee-validate/zod": "4.15.1",
    "reka-ui": "2.10.3",
    "sql.js": "1.14.1",
    "vee-validate": "4.15.1",
    "vue": "3.5.41",
    "vue-router": "5.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.4",
    "@testing-library/vue": "8.1.0",
    "@types/emscripten": "1.41.5",
    "@types/node": "26.2.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sort-destructure-keys": "3.0.0",
    "eslint-plugin-vue": "10.10.0",
    "eslint-plugin-vuejs-accessibility": "2.6.0",
    "jiti": "2.7.0",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "postcss-preset-env": "11.3.2",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9",
    "workbox-window": "7.4.1"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "engines": {
    "node": "^24.0.0"
  }
}
