{
  "name": "mizukara",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "VITE_HTTPS=1 vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:local": "playwright test --project=chromium --workers=2",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts",
    "test:e2e:vrt": "playwright test --project=visual",
    "test:all": "vitest run && playwright test --project=chromium",
    "type-check": "vue-tsc --noEmit && vue-tsc -p tsconfig.test.json --noEmit && vue-tsc -p tsconfig.e2e.json --noEmit",
    "lint": "prettier --check . && eslint . && stylelint \"src/**/*.{css,vue}\" && vue-tsc --noEmit",
    "lint-fix": "prettier --write --list-different . && eslint . --fix && stylelint \"src/**/*.{css,vue}\" --fix && vue-tsc --noEmit",
    "check": "pnpm lint",
    "check:fix": "pnpm lint-fix",
    "prettier-only": "prettier --check",
    "prettier-fix-only": "prettier --write --list-different",
    "eslint-only": "eslint",
    "eslint-fix-only": "eslint --fix",
    "stylelint-only": "stylelint \"src/**/*.{css,vue}\"",
    "stylelint-fix-only": "stylelint \"src/**/*.{css,vue}\" --fix",
    "check:unused": "python3 find-unused-files.py",
    "check:untested": "python3 find-untested-files.py",
    "ci": "pnpm lint && pnpm test",
    "ci:full": "pnpm lint && pnpm test:all"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@vee-validate/zod": "4.15.1",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "reka-ui": "2.11.0",
    "sql.js": "1.15.0",
    "vee-validate": "4.15.1",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.8",
    "@testing-library/vue": "8.1.0",
    "@types/emscripten": "1.41.6",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sort-destructure-keys": "3.0.0",
    "eslint-plugin-vue": "10.11.1",
    "eslint-plugin-vuejs-accessibility": "2.6.2",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13",
    "workbox-window": "7.4.1"
  },
  "packageManager": "pnpm@11.28.6+sha512.55d90390c3b39042f1505a2697789f0256c6d95bb28bdd7cb731af1887c9f2629ef581acb9f4e4ec772024c8203c2aed22a03299b97103fdcf32668e905d0024",
  "engines": {
    "node": "^24.0.0"
  }
}
