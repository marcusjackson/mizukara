#!/bin/sh
# pre-push — run the repo's path-scoped local gate before a push leaves the machine.
# Machine-written by fleet-sync (block pre-push-hook); edit the source in the tooling repo.
# Enable with `make install-hooks`. Bypass once with `git push --no-verify`.

# Pushing only deletions has nothing to check.
checked=
while read -r _lref lsha _rref _rsha; do
  case $lsha in 0000000000000000000000000000000000000000) ;; *) checked=1 ;; esac
done
[ -n "$checked" ] || exit 0

cd "$(git rev-parse --show-toplevel)" || exit 1

# A fresh worktree has no dependencies; failing the push on that would only teach people to bypass.
if [ ! -e node_modules ]; then
  echo "pre-push: no node_modules here, gate skipped. Link or install them to run it." >&2
  exit 0
fi

# A repo's quick push tier (pre-push) wins over its merge gate (ci), which wins over check.
if make -n pre-push >/dev/null 2>&1; then gate=pre-push
elif make -n ci >/dev/null 2>&1; then gate=ci
else gate=check; fi
log=$(mktemp "${TMPDIR:-/tmp}/pre-push-gate.XXXXXX")
echo "pre-push: make $gate (log: $log)" >&2
if make "$gate" >"$log" 2>&1; then
  grep '^GATE-SUMMARY' "$log" >&2
  rm -f "$log"
  exit 0
fi
tail -n 40 "$log" >&2
echo "pre-push: make $gate failed; push blocked. Full log: $log" >&2
exit 1
