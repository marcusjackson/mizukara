{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* E2E tests use Playwright's expect, not Vitest's — no vitest/globals needed. */
    "types": ["node"]
  },
  "include": [
    "e2e/**/*.ts",
    "e2e-production/**/*.ts",
    "playwright.config.ts",
    "playwright.production.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
